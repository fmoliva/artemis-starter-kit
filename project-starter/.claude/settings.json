{
  "autoCompactWindow": 150000,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/session-startup-guard.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/vault-first-guard.sh\"'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/nav-flow-guard.sh\"'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__playwright__",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/subagent-browser-block.sh\"'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/report-write-guard.sh\"'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/done-bug-gate.sh\"'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/state-assertion-guard.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/detect-server-errors.sh\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/report-format-guard.sh\"'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/evidence-trace-check.sh\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/report-format-guard.sh\"'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/evidence-trace-check.sh\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/reference-read-logger.sh\"'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd) && \"$root/.claude/hooks/recent-read-logger.sh\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
